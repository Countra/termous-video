{
  "archives": [
    "lib/libplacebo.a",
    "lib/libMoltenVK.a",
    "lib/libMoltenVK_ShaderConverter.a",
    "lib/libMoltenVK_Common.a",
    "lib/libspirv-cross-msl.a",
    "lib/libspirv-cross-reflect.a",
    "lib/libspirv-cross-glsl.a",
