include(CheckSymbolExists)
include(CheckCSourceCompiles)
include(CheckCCompilerFlag)
set(X264_STACK_ALIGNMENT 16)
if(NOT APPLE)
  check_c_compiler_flag(-mpreferred-stack-boundary=6 X264_STACK_64)
  if(X264_STACK_64)
    set(X264_STACK_ALIGNMENT 64)
  endif()
endif()
set(CMAKE_REQUIRED_LIBRARIES m)
if(WIN32)
  set(CMAKE_REQUIRED_LIBRARIES "")
endif()
check_symbol_exists(log2f math.h HAVE_LOG2F)
check_symbol_exists(strtok_r string.h HAVE_STRTOK_R)
check_symbol_exists(clock_gettime time.h HAVE_CLOCK_GETTIME)
check_symbol_exists(sysconf unistd.h HAVE_SYSCONF)
# 此宏决定 memalign/free 配对，不能只检查 malloc.h 是否存在。
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
  check_symbol_exists(memalign malloc.h X264_HAVE_MEMALIGN)
  set(HAVE_MALLOC_H ${X264_HAVE_MEMALIGN})
else()
  set(HAVE_MALLOC_H 0)
endif()
check_c_source_compiles("int main(void) { int n = 0; return __sync_fetch_and_add(&n, 1); }" HAVE_SYNC_FETCH_AND_ADD)
check_c_source_compiles("int main(void) { unsigned v __attribute__((vector_size(16))) = {0}; return v[0]; }" HAVE_VECTOREXT)
unset(CMAKE_REQUIRED_LIBRARIES)

# 对应官方 configure 的可选项全集；未启用功能明确为零。
set(X264_FEATURES
  MALLOC_H ALTIVEC ALTIVEC_H MMX ARMV6 ARMV6T2 NEON AARCH64 BEOSTHREAD
  POSIXTHREAD WIN32THREAD THREAD LOG2F SWSCALE LAVF FFMS GPAC AVS GPL VECTOREXT
  INTERLACED CPU_COUNT OPENCL THP LSMASH X86_INLINE_ASM AS_FUNC INTEL_DISPATCHER
  MSA LSX MMAP WINRT VSX ARM_INLINE_ASM STRTOK_R CLOCK_GETTIME BITDEPTH8 BITDEPTH10
  ELF_AUX_INFO GETAUXVAL SYSCONF SYNC_FETCH_AND_ADD DOTPROD I8MM SVE SVE2 RISCV64 RVV
  AS_ARCHEXT_DOTPROD_DIRECTIVE AS_ARCHEXT_I8MM_DIRECTIVE
  AS_ARCHEXT_SVE_DIRECTIVE AS_ARCHEXT_SVE2_DIRECTIVE)
set(HAVE_THREAD 1)
set(HAVE_GPL 1)
set(HAVE_BITDEPTH8 1)
set(X264_CONFIG "/* 自动生成：固定为 8 位、4:2:0、逐行编码，保留平台线程与 SIMD。 */\n")
if(WIN32)
  set(HAVE_WIN32THREAD 1)
  string(APPEND X264_CONFIG "#define SYS_WINDOWS 1\n")
else()
  find_package(Threads REQUIRED)
  set(HAVE_POSIXTHREAD 1)
  set(HAVE_MMAP 1)
  if(APPLE)
    string(APPEND X264_CONFIG "#define SYS_MACOSX 1\n")
  else()
    string(APPEND X264_CONFIG "#define SYS_LINUX 1\n")
    set(CMAKE_REQUIRED_DEFINITIONS -D_GNU_SOURCE)
    check_symbol_exists(CPU_COUNT sched.h HAVE_CPU_COUNT)
    check_symbol_exists(MADV_HUGEPAGE sys/mman.h HAVE_THP)
    unset(CMAKE_REQUIRED_DEFINITIONS)
  endif()
endif()
if(APPLE)
  set(HAVE_AARCH64 1)
  set(HAVE_NEON 1)
  string(APPEND X264_CONFIG "#define ARCH_AARCH64 1\n#define STACK_ALIGNMENT 16\n#define AS_ARCH_LEVEL armv8-a\n")
else()
  set(HAVE_MMX 1)
  set(HAVE_X86_INLINE_ASM 1)
  string(APPEND X264_CONFIG "#define ARCH_X86_64 1\n#define STACK_ALIGNMENT ${X264_STACK_ALIGNMENT}\n")
endif()
foreach(feature IN LISTS X264_FEATURES)
  if(HAVE_${feature})
    string(APPEND X264_CONFIG "#define HAVE_${feature} 1\n")
  else()
    string(APPEND X264_CONFIG "#define HAVE_${feature} 0\n")
  endif()
endforeach()
string(APPEND X264_CONFIG "#define CHROMA_FORMAT CHROMA_420\n")
file(CONFIGURE OUTPUT "${X264_CONFIG_DIR}/config.h" CONTENT "${X264_CONFIG}" @ONLY)

file(READ "${CMAKE_CURRENT_LIST_DIR}/../build-lock.json" X264_LOCK)
string(JSON X264_VERSION GET "${X264_LOCK}" x264 version)
string(JSON X264_REVISION GET "${X264_LOCK}" x264 revision)
file(STRINGS "${H264_ROOT}/x264.h" X264_BUILD_LINE REGEX "^#define X264_BUILD [0-9]+$")
if(NOT X264_BUILD_LINE STREQUAL "#define X264_BUILD 165")
  message(FATAL_ERROR "x264 ABI changed; review the recipe and smoke tests")
endif()
configure_file("${CMAKE_CURRENT_LIST_DIR}/x264_config.h.in" "${X264_CONFIG_DIR}/x264_config.h" @ONLY)
