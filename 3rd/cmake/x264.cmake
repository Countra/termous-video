include(${CMAKE_CURRENT_LIST_DIR}/x264_sources.cmake)
set(X264_CONFIG_DIR "${CMAKE_CURRENT_BINARY_DIR}/x264-config")
file(MAKE_DIRECTORY "${X264_CONFIG_DIR}")
include(${CMAKE_CURRENT_LIST_DIR}/x264_config.cmake)

if(APPLE)
  enable_language(ASM)
  list(APPEND X264_8BIT ${X264_ARM_C} ${X264_ARM_ASM})
else()
  if(WIN32)
    set(CMAKE_ASM_NASM_OBJECT_FORMAT win64)
    list(APPEND X264_COMMON common/win32thread.c)
  else()
    set(CMAKE_ASM_NASM_OBJECT_FORMAT elf64)
  endif()
  enable_language(ASM_NASM)
  list(APPEND X264_COMMON common/x86/cpu-a.asm)
  list(APPEND X264_8BIT ${X264_X86_C} ${X264_X86_ASM})
endif()
list(TRANSFORM X264_COMMON PREPEND "${H264_ROOT}/")
list(TRANSFORM X264_8BIT PREPEND "${H264_ROOT}/")
add_library(x264 STATIC ${X264_COMMON} ${X264_8BIT})
set_source_files_properties(${X264_8BIT} PROPERTIES
  COMPILE_DEFINITIONS "BIT_DEPTH=8;HIGH_BIT_DEPTH=0;$<$<COMPILE_LANGUAGE:ASM_NASM>:private_prefix=x264_8>")
set_target_properties(x264 PROPERTIES C_STANDARD 99 C_STANDARD_REQUIRED ON C_EXTENSIONS ON)
target_include_directories(x264 PRIVATE "${X264_CONFIG_DIR}" "${H264_ROOT}")
# 与上游优化参数保持一致；不使用 -march=native，以便产物跨设备运行。
target_compile_options(x264 PRIVATE "$<$<COMPILE_LANGUAGE:C>:-O3;-ffast-math;-fno-tree-vectorize;-fvisibility=hidden>")
if(APPLE)
  target_compile_definitions(x264 PRIVATE "$<$<COMPILE_LANGUAGE:ASM>:PREFIX;PIC>")
else()
  if(X264_STACK_64)
    target_compile_options(x264 PRIVATE "$<$<COMPILE_LANGUAGE:C>:-mpreferred-stack-boundary=6>")
  endif()
  target_include_directories(x264 PRIVATE "${H264_ROOT}/common/x86")
  target_compile_definitions(x264 PRIVATE "$<$<COMPILE_LANGUAGE:ASM_NASM>:ARCH_X86_64=1;STACK_ALIGNMENT=${X264_STACK_ALIGNMENT};PIC>")
endif()
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
  target_compile_definitions(x264 PRIVATE "$<$<COMPILE_LANGUAGE:C>:_GNU_SOURCE>")
endif()
